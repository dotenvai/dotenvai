{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotenv.ai/schema/discovery-v0.1.schema.json",
  "title": "Agent Skill Discovery Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "publisher", "skills"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "version", "source"],
        "properties": {
          "name": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
          "source": { "type": "string", "format": "uri", "pattern": "^https://" },
          "archive": { "type": "string", "format": "uri", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "license": { "type": "string", "minLength": 1 },
          "compatibility": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        },
        "dependentRequired": { "archive": ["sha256"], "sha256": ["archive"] }
      }
    }
  }
}
